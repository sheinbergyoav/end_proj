// tq_tie_sdot4.tie
// 4-way signed INT8 SIMD Dot Product with 32-bit Accumulation

operation SDOT4 {inout AR acc, in AR a_packed, in AR b_packed} {} {
    // Unpack and explicitly sign-extend the 4 bytes from 'a' to 32 bits
    wire [31:0] a0 = { {24{a_packed[7]}},  a_packed[7:0] };
    wire [31:0] a1 = { {24{a_packed[15]}}, a_packed[15:8] };
    wire [31:0] a2 = { {24{a_packed[23]}}, a_packed[23:16] };
    wire [31:0] a3 = { {24{a_packed[31]}}, a_packed[31:24] };

    // Unpack and explicitly sign-extend the 4 bytes from 'b' to 32 bits
    wire [31:0] b0 = { {24{b_packed[7]}},  b_packed[7:0] };
    wire [31:0] b1 = { {24{b_packed[15]}}, b_packed[15:8] };
    wire [31:0] b2 = { {24{b_packed[23]}}, b_packed[23:16] };
    wire [31:0] b3 = { {24{b_packed[31]}}, b_packed[31:24] };

    // Perform 4 parallel multiplications
    // Two's complement guarantees the lower 32 bits are perfectly correct
    wire [31:0] prod0 = a0 * b0;
    wire [31:0] prod1 = a1 * b1;
    wire [31:0] prod2 = a2 * b2;
    wire [31:0] prod3 = a3 * b3;

    // Accumulate all 4 products in a single cycle
    assign acc = acc + prod0 + prod1 + prod2 + prod3;
}
